# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) hoặc legacy "anon" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) hoặc legacy "service_role" key — CHỈ dùng ở server, không commit
SUPABASE_SERVICE_ROLE_KEY=

# URL công khai của site (dùng cho metadata, link báo giá)
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# Tài khoản admin riêng cho test Playwright (npm run test:e2e tự tạo nếu chưa có)
E2E_ADMIN_EMAIL=e2e-admin@thegioiden98.test
E2E_ADMIN_PASSWORD=
